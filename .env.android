# Used by the Android app build (npm run android:sync). The web app ignores it: it calls /api on its own origin.
#
# Where the app finds the backend:
#   http://10.0.2.2:8080          the Android emulator reaching the backend on this computer (default below)
#   http://192.168.1.20:8080      a real phone on the same Wi-Fi as this computer (use the computer's IP address)
#   https://api.your-domain.in    a deployed backend: required for builds sent to the Play Store
#
# Put your own value in .env.android.local (not committed) rather than changing this file.
VITE_API_BASE_URL=http://10.0.2.2:8080
